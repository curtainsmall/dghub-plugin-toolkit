# Whitelist approach: ignore all, then un-ignore tracked content
*

# Root files
!.gitignore
!.gitattributes
!README.md
!CHANGELOG.md
!LICENSE

# Source directories
!.github/
!.github/**
!studio/
!studio/**
!sdk/
!sdk/**
!demo/
!demo/**
!docs/
!docs/**

# Re-ignore build outputs
studio/bin/
studio/installer/
studio/src/backend/_version.py
sdk/**/dist/
sdk/**/node_modules/
demo/**/vendor/
demo/**/node_modules/
demo/**/dist/
demo/**/*.zip
demo/**/debug/

# Re-ignore generated & cache
__pycache__/
*.pyc
*.egg-info/
cache/
output/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Re-ignore local project state
.dghub-sdk/
sdk/**/build/
